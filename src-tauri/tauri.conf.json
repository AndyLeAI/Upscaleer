{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upscaleer",
  "version": "1.0.0",
  "identifier": "com.andyleai.upscaleer",
  "build": {
    "beforeDevCommand": "npm --prefix upstream run dev -- --host 127.0.0.1 --port 4321",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "node scripts/build-desktop.cjs",
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Upscaleer",
        "width": 1330,
        "height": 840,
        "minWidth": 820,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
